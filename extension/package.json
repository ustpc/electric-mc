{
  "name": "electric-mc-extension",
  "private": true,
  "version": "0.0.30",
  "description": "Electric MC test extension: page parsers, debug overlay, and logging for Manuscript Central",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "STORE=1 wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1",
    "preact": "^11.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
