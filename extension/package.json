{
  "name": "electric-mc-extension",
  "private": true,
  "version": "0.0.107",
  "description": "Electric MC: a better Manuscript Central for editors, with notes, queues and checks, all in your browser",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "wxt build",
    "postbuild": "node scripts/check-no-remote-code.mjs && node scripts/check-permissions.mjs",
    "check:remote-code": "node scripts/check-no-remote-code.mjs",
    "prezip": "node scripts/fetch-model.mjs",
    "prezip:store": "node scripts/fetch-model.mjs",
    "zip": "wxt zip",
    "zip:store": "STORE=1 wxt zip",
    "postzip": "node scripts/check-no-remote-code.mjs && node scripts/check-permissions.mjs",
    "postzip:store": "node scripts/check-no-remote-code.mjs && node scripts/check-permissions.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load": "node tools/e2e/load-check.mjs build/chrome-mv3",
    "test:page": "node tools/e2e/page-check.mjs build/chrome-mv3",
    "validate": "tsx tools/validate.ts",
    "coverage": "vitest run --coverage",
    "ae-profiles": "tsx tools/ae-profiles/build.ts",
    "lint": "npm --prefix tools/lint ci --silent --no-audit --no-fund && tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.mjs --max-warnings 0 .",
    "lint:quick": "tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.mjs --max-warnings 0 .",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:real-data": "node ../tools/privacy/check-no-real-data.mjs",
    "test:real": "vitest run --config vitest.real.config.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "playwright": "1.56.1",
    "preact": "^11.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "pdfjs-dist": "6.4.299"
  }
}
